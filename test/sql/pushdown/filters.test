# name: test/sql/pushdown/filters.test
# description: filters are evaluated by ClickHouse when the translation is exact
# group: [pushdown]

require clickhouse_scanner

require-env CLICKHOUSE_TEST_HOST

require-env CLICKHOUSE_TEST_PORT

require-env CLICKHOUSE_TEST_USER

require-env CLICKHOUSE_TEST_PASSWORD

require icu

statement ok
SET TimeZone = 'UTC';

statement ok
ATTACH 'host=${CLICKHOUSE_TEST_HOST} port=${CLICKHOUSE_TEST_PORT} user=${CLICKHOUSE_TEST_USER} password=${CLICKHOUSE_TEST_PASSWORD} database=test_db' AS ch (TYPE clickhouse);

# integers
query II
SELECT id, name FROM ch.test_db.t1 WHERE id = 2;
----
2	Bob

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id, name FROM ch.test_db.t1 WHERE id = 2;
----
analyzed_plan	<REGEX>:.*"ClickHouse Query": "SELECT `id`, `name` FROM `test_db`.`t1` WHERE `id` = 2".*

query I
SELECT id FROM ch.test_db.t1 WHERE id = 1 OR id = 3 ORDER BY id;
----
1
3

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.t1 WHERE id = 1 OR id = 3;
----
analyzed_plan	<REGEX>:.*"ClickHouse Query": "SELECT `id` FROM `test_db`.`t1`".*

# not pushed: DuckDB pushes a non-dense OR/IN as an OPTIONAL_FILTER (a zone-map pruning hint, not required
# for correctness) and keeps the real predicate as a Filter operator above the scan -- pushing the optional
# copy into ClickHouse too would be redundant at best, and would return wrong rows if a LIMIT above the scan
# were ever pushed alongside it
query I
SELECT id FROM ch.test_db.t1 WHERE name IN ('Alice', 'Charlie') ORDER BY id;
----
1
3

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.t1 WHERE name IN ('Alice', 'Charlie');
----
analyzed_plan	<REGEX>:.*"ClickHouse Query": "SELECT [^"]*FROM `test_db`.`t1`".*

query I
SELECT count(*) FROM ch.test_db.t1 WHERE name = 'O''Brien\';
----
0

query I
SELECT id FROM ch.test_db.nullables WHERE lcs = 'y';
----
2

# ranges on one column
query I
SELECT id FROM ch.test_db.nullables WHERE i > 0 AND i < 100;
----
2

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.nullables WHERE i > 0 AND i < 100;
----
analyzed_plan	<REGEX>:.*WHERE .*`i` > 0.*`i` < 100.*

# NULL checks
query I
SELECT id FROM ch.test_db.nullables WHERE i IS NULL;
----
1

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.nullables WHERE i IS NULL;
----
analyzed_plan	<REGEX>:.*WHERE `i` IS NULL.*

query I
SELECT id FROM ch.test_db.nullables WHERE i IS NOT NULL;
----
2

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.nullables WHERE i IS NOT NULL;
----
analyzed_plan	<REGEX>:.*WHERE `i` IS NOT NULL.*

# temporal types
query I
SELECT id FROM ch.test_db.t1 WHERE created_at >= TIMESTAMPTZ '2024-01-02 00:00:00+00' ORDER BY id;
----
2
3

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.t1 WHERE created_at >= TIMESTAMPTZ '2024-01-02 00:00:00+00';
----
analyzed_plan	<REGEX>:.*`created_at` >= fromUnixTimestamp64Micro\(1704153600000000, 'UTC'\).*

# created_at is a ClickHouse DateTime (second precision, no fractional part): a sub-second constant must still
# compare exactly rather than being narrowed to whole seconds either side
query I
SELECT id FROM ch.test_db.t1 WHERE created_at >= TIMESTAMPTZ '2024-01-02 00:00:00.5+00' ORDER BY id;
----
3

query I
SELECT id FROM ch.test_db.scalars WHERE d = DATE '2024-02-29';
----
1

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.scalars WHERE d = DATE '2024-02-29';
----
analyzed_plan	<REGEX>:.*`d` = toDate32\('2024-02-29'\).*

# toDate32 clamps rather than errors on an out-of-range argument: pushing a comparison against a date outside
# [1900-01-01, 2299-12-31] would match/exclude rows ClickHouse itself would not, so these fold to an exact
# constant predicate instead
query I
SELECT id FROM ch.test_db.scalars WHERE d32 = DATE '1850-01-01';
----

query I
SELECT id FROM ch.test_db.scalars WHERE d32 < DATE '2400-01-01' ORDER BY id;
----
1
2

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.scalars WHERE d32 = DATE '1850-01-01';
----
analyzed_plan	<REGEX>:.*"ClickHouse Query": "SELECT `d32`, `id` FROM `test_db`.`scalars` WHERE 1 = 0".*

# +-infinity constants fold the same way as an out-of-range Date rather than failing the query
query I
SELECT count(*) FROM ch.test_db.scalars WHERE d < 'infinity'::DATE;
----
2

# DateTime64 with precision above 6 (microseconds) is floor-truncated by ClickhouseConversion on read, so a
# comparison at the column's own (higher) precision could match/exclude rows differently than the truncated
# DuckDB value would: not pushed
query I
SELECT id FROM ch.test_db.scalars WHERE dt64_9 > TIMESTAMPTZ '1970-01-01 00:00:00+00';
----
1

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.scalars WHERE dt64_9 > TIMESTAMPTZ '1970-01-01 00:00:00+00';
----
analyzed_plan	<REGEX>:.*"ClickHouse Query": "SELECT [^"]*FROM `test_db`.`scalars`".*

# decimals, enums and booleans
query I
SELECT id FROM ch.test_db.scalars WHERE d9 > 1000.00::DECIMAL(9, 2);
----
1

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.scalars WHERE d9 > 1000.00::DECIMAL(9, 2);
----
analyzed_plan	<REGEX>:.*`d9` > toDecimal128\('1000.00', 2\).*

query I
SELECT id FROM ch.test_db.scalars WHERE d9 > -5.00::DECIMAL(9, 2) ORDER BY id;
----
1
2

query I
SELECT id FROM ch.test_db.scalars WHERE e8 = 'blue';
----
1

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.scalars WHERE e8 = 'blue';
----
analyzed_plan	<REGEX>:.*`e8` = 'blue'.*

# 'purple' is not one of e8's members: pushed as `e8` = 'purple', ClickHouse can raise UNKNOWN_ELEMENT_OF_ENUM
# (observed for !=) instead of just not matching -- must not be pushed either way
query I
SELECT id FROM ch.test_db.scalars WHERE e8 = 'purple';
----

query I
SELECT id FROM ch.test_db.scalars WHERE e8 != 'purple' ORDER BY id;
----
1
2

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.scalars WHERE e8 != 'purple';
----
analyzed_plan	<REGEX>:.*"ClickHouse Query": "SELECT [^"]*FROM `test_db`.`scalars`".*

# relational comparisons on the CAST(e8 AS VARCHAR) rewrite are not pushed: ClickHouse's Enum8 ordering
# (declaration order) need not match the VARCHAR ordering DuckDB's rewritten comparison implies
query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.scalars WHERE e8 < 'red';
----
analyzed_plan	<REGEX>:.*"ClickHouse Query": "SELECT [^"]*FROM `test_db`.`scalars`".*

query I
SELECT id FROM ch.test_db.scalars WHERE b;
----
1

# beyond +-2^63, a bare integer literal parses as Float64 in ClickHouse (losing precision) instead of comparing
# exactly against an Int128/UInt128 column
query I
SELECT id FROM ch.test_db.scalars WHERE i128 = -170141183460469231731687303715884105728;
----
1

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.scalars WHERE i128 = -170141183460469231731687303715884105728;
----
analyzed_plan	<REGEX>:.*`i128` = toInt128\('-170141183460469231731687303715884105728'\).*

query I
SELECT id FROM ch.test_db.scalars WHERE u128 = 340282366920938463463374607431768211455;
----
1

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.scalars WHERE u128 = 340282366920938463463374607431768211455;
----
analyzed_plan	<REGEX>:.*`u128` = toUInt128\('340282366920938463463374607431768211455'\).*

# ClickHouse tables have no row identifier: rowid always reads as NULL, so filtering on it consistently matches
# nothing instead of crashing (plan_get.cpp indexes a virtual-column map keyed by rowid's type when a filter on
# it can't be pushed)
query I
SELECT id FROM ch.test_db.t1 WHERE rowid = 0;
----

# not pushed: floats (NaN semantics differ) and UUIDs (ordering differs); DuckDB filters instead
query I
SELECT id FROM ch.test_db.t1 WHERE value > 100 ORDER BY id;
----
2
3

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.t1 WHERE value > 100;
----
analyzed_plan	<REGEX>:.*"ClickHouse Query": "SELECT [^"]*FROM `test_db`.`t1`".*

# a filter-only column (value) not part of the SELECT list, with the remaining projection reordered
query II
SELECT name, id FROM ch.test_db.t1 WHERE value > 100 ORDER BY id;
----
Bob	2
Charlie	3

query I
SELECT count(*) FROM ch.test_db.t1 WHERE value > 100;
----
2

query I
SELECT id FROM ch.test_db.scalars WHERE uuid = '61f0c404-5cb3-11e7-907b-a6006ad3dba0';
----
1

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.scalars WHERE uuid = '61f0c404-5cb3-11e7-907b-a6006ad3dba0';
----
analyzed_plan	<REGEX>:.*"ClickHouse Query": "SELECT [^"]*FROM `test_db`.`scalars`".*

# pushed and non-pushed filters together
query I
SELECT id FROM ch.test_db.t1 WHERE id >= 2 AND value < 200;
----
2

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id FROM ch.test_db.t1 WHERE id >= 2 AND value < 200;
----
analyzed_plan	<REGEX>:.*"ClickHouse Query": "SELECT [^"]*FROM `test_db`.`t1` WHERE `id` >= 2".*

# the setting turns pushdown off
statement ok
SET ch_filter_pushdown = false;

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT id, name FROM ch.test_db.t1 WHERE id = 2;
----
analyzed_plan	<REGEX>:.*"ClickHouse Query": "SELECT `id`, `name` FROM `test_db`.`t1`".*

query II
SELECT id, name FROM ch.test_db.t1 WHERE id = 2;
----
2	Bob
