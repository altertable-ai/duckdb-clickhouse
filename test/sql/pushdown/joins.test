# name: test/sql/pushdown/joins.test
# description: a join-pushed filter on a ClickHouse scan is never applied inside ClickHouse
# group: [pushdown]

require clickhouse_scanner

require-env CLICKHOUSE_TEST_HOST

require-env CLICKHOUSE_TEST_PORT

require-env CLICKHOUSE_TEST_USER

require-env CLICKHOUSE_TEST_PASSWORD

statement ok
ATTACH 'host=${CLICKHOUSE_TEST_HOST} port=${CLICKHOUSE_TEST_PORT} user=${CLICKHOUSE_TEST_USER} password=${CLICKHOUSE_TEST_PASSWORD} database=test_db' AS ch (TYPE clickhouse);

# A single-row build side (here, the VALUES list) makes DuckDB's hash join push an exact-value equality filter
# onto the scan at execution time, through the LIMIT/TOP_N, as a runtime-only "dynamic" filter for pruning --
# not through table_filters/OPTIONAL_FILTER, but a separate, unwrapped ConstantFilter DuckDB attaches to
# LogicalGet::dynamic_filters once the join's build phase resolves (physical_hash_join.cpp); it is never
# required for correctness (the join itself still checks the real condition). Applying it as a hard ClickHouse
# WHERE would filter before ORDER BY/LIMIT ran, changing which rows the top 3 even are -- see task-8 fix round
# 1 (ClickhouseInitGlobal now sources filters from PhysicalTableScan::table_filters, before that merge, instead
# of TableFunctionInitInput::filters). The true top 3 of `big` are 0, 1, 2, so joining against 5000000 must
# return no rows, regardless of whether the ORDER BY ... LIMIT itself is pushed.
query I
SELECT a.n FROM (SELECT n FROM ch.test_db.big ORDER BY n LIMIT 3) a JOIN (VALUES (5000000::UBIGINT)) v(x) ON a.n = v.x;
----

statement ok
SET ch_order_pushdown = false;

query I
SELECT a.n FROM (SELECT n FROM ch.test_db.big ORDER BY n LIMIT 3) a JOIN (VALUES (5000000::UBIGINT)) v(x) ON a.n = v.x;
----

statement ok
SET ch_order_pushdown = true;

# positive control: the same shape of query, but the join key is actually among the true top 3 (descending)
query I
SELECT a.n FROM (SELECT n FROM ch.test_db.big ORDER BY n DESC LIMIT 3) a JOIN (VALUES (9999998::UBIGINT)) v(x) ON a.n = v.x;
----
9999998

# a dense IN-list is a REQUIRED (non-optional) filter (transformed into >= AND <=) and is unaffected by this fix
query I
SELECT count(*) FROM ch.test_db.big WHERE n IN (1, 2, 3);
----
3

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT n FROM ch.test_db.big WHERE n IN (1, 2, 3);
----
analyzed_plan	<REGEX>:.*"ClickHouse Query": "SELECT `n` FROM `test_db`.`big` WHERE .*`n`.*".*
