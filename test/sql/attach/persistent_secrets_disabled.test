# name: test/sql/attach/persistent_secrets_disabled.test
# description: ATTACH keeps working when persistent secrets are disabled
# group: [attach]

require clickhouse_scanner

# SecretManager::GetSecretByName throws "Unknown secret storage found" for a storage it has not
# registered, and it only registers local_file when persistent secrets are enabled -- so looking that
# storage up by name breaks every entry point under this (normal for embedded and multi-tenant hosts)
# configuration, even when no secret is involved at all.
# Has to be the first statement: the setting cannot be changed once the secret manager has been used.
statement ok
SET allow_persistent_secrets=false;

# the ATTACH gets all the way to connecting (nothing listens on port 1) instead of failing in the
# secret lookup
statement error
ATTACH 'host=127.0.0.1 port=1 user=duckdb password=duckdb database=test_db' AS ch_no_persist (TYPE clickhouse);
----
Failed to connect to ClickHouse at
