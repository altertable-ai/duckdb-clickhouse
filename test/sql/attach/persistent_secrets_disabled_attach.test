# name: test/sql/attach/persistent_secrets_disabled_attach.test
# description: a real ATTACH and scan with persistent secrets disabled
# group: [attach]

require clickhouse_scanner

require-env CLICKHOUSE_TEST_HOST

require-env CLICKHOUSE_TEST_PORT

require-env CLICKHOUSE_TEST_USER

require-env CLICKHOUSE_TEST_PASSWORD

# see persistent_secrets_disabled.test; has to be the first statement in the file
statement ok
SET allow_persistent_secrets=false;

statement ok
ATTACH 'host=${CLICKHOUSE_TEST_HOST} port=${CLICKHOUSE_TEST_PORT} user=${CLICKHOUSE_TEST_USER} password=${CLICKHOUSE_TEST_PASSWORD} database=test_db' AS ch_no_persist (TYPE clickhouse);

query I
SELECT count(*) FROM ch_no_persist.test_db.t1;
----
3
