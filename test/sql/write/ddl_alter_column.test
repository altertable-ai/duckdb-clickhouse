# name: test/sql/write/ddl_alter_column.test
# description: ALTER TABLE … ALTER COLUMN (SET/DROP DEFAULT, SET/DROP NOT NULL, TYPE) on attached ClickHouse tables
# group: [write]

require clickhouse_scanner

require icu

require-env CLICKHOUSE_TEST_HOST

require-env CLICKHOUSE_TEST_PORT

require-env CLICKHOUSE_TEST_USER

require-env CLICKHOUSE_TEST_PASSWORD

statement ok
SET TimeZone = 'UTC';

statement ok
ATTACH 'host=${CLICKHOUSE_TEST_HOST} port=${CLICKHOUSE_TEST_PORT} user=${CLICKHOUSE_TEST_USER} password=${CLICKHOUSE_TEST_PASSWORD} database=test_db' AS ch (TYPE clickhouse);

statement ok
CALL clickhouse_execute('ch', 'DROP DATABASE IF EXISTS w_alter');

statement ok
CALL clickhouse_execute('ch', 'CREATE DATABASE w_alter');

statement ok
CALL clickhouse_execute('ch', 'CREATE TABLE w_alter.t (id Int32, p Int32, a Nullable(Int32), b Int64, s LowCardinality(String), n Nullable(Int32), d Date32, dec Decimal(10, 2), f Float64, arr Array(Int32), txt Nullable(String), m Int32 MATERIALIZED id * 2) ENGINE = MergeTree PARTITION BY p ORDER BY id');

statement ok
CALL clickhouse_execute('ch', 'INSERT INTO w_alter.t (id, p, a, b, s, n, d, dec, f, arr, txt) VALUES (1, 0, 10, 3000000000, ''x'', NULL, ''2024-01-02'', 1.25, 2.5, [1], ''12''), (2, 0, NULL, -1, ''y'', 5, ''1900-01-01'', -3.5, 1.5, [], ''abc'')');

# ---------------------------------------------------------------------------
# SET DEFAULT / DROP DEFAULT: metadata only, the type is kept
# ---------------------------------------------------------------------------
statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN a SET DEFAULT 42;

query III
SELECT * FROM clickhouse_query('ch', 'SELECT type, default_kind, default_expression FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''a''');
----
Nullable(Int32)	DEFAULT	42

statement ok
INSERT INTO ch.w_alter.t (id, p, b, s, d, dec, f, arr) VALUES (3, 1, 7, 'z', DATE '2000-01-01', 0, 0, []);

query I
SELECT a FROM ch.w_alter.t WHERE id = 3;
----
42

query I
SELECT * FROM clickhouse_query('ch', 'SELECT a FROM w_alter.t WHERE id = 3');
----
42

statement ok
DELETE FROM ch.w_alter.t WHERE id = 3;

# the constant is cast to the column's type, like a CREATE TABLE DEFAULT
statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN a SET DEFAULT '7';

query II
SELECT * FROM clickhouse_query('ch', 'SELECT type, default_expression FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''a''');
----
Nullable(Int32)	7

statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN s SET DEFAULT 'it''s';

query II
SELECT * FROM clickhouse_query('ch', 'SELECT type, default_expression FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''s''');
----
LowCardinality(String)	'it\'s'

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN d SET DEFAULT current_date;
----
DEFAULT value of column "d" must be a constant for ClickHouse tables

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN a SET DEFAULT random();
----
DEFAULT value of column "a" must be a constant for ClickHouse tables

# a MATERIALIZED (or ALIAS) column would silently become a DEFAULT one
statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN m SET DEFAULT 1;
----
Column "m" of ClickHouse table "t" is MATERIALIZED

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN m DROP DEFAULT;
----
Column "m" of ClickHouse table "t" is MATERIALIZED

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN nope SET DEFAULT 1;
----
Column with name "nope" does not exist in ClickHouse table "t"

statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN a DROP DEFAULT;

query III
SELECT * FROM clickhouse_query('ch', 'SELECT type, default_kind, default_expression FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''a''');
----
Nullable(Int32)	(empty)	(empty)

# nothing to drop: nothing is sent (ClickHouse itself would refuse REMOVE DEFAULT)
statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN a DROP DEFAULT;

# ---------------------------------------------------------------------------
# a part written before ADD COLUMN does not store the column, and ClickHouse computes it there from the current
# default: the column is materialized first, so SET/DROP DEFAULT leave existing rows alone, as in DuckDB. One
# partition per row: parts of different partitions never merge (a merge would store the column too)
# ---------------------------------------------------------------------------
statement ok
CALL clickhouse_execute('ch', 'CREATE TABLE w_alter.dflt (id Int32) ENGINE = MergeTree PARTITION BY id ORDER BY id');

statement ok
INSERT INTO ch.w_alter.dflt VALUES (1), (2);

statement ok
INSERT INTO ch.w_alter.dflt VALUES (3);

statement ok
ALTER TABLE ch.w_alter.dflt ADD COLUMN c INTEGER DEFAULT 5;

statement ok
ALTER TABLE ch.w_alter.dflt ADD COLUMN e INTEGER;

statement ok
INSERT INTO ch.w_alter.dflt VALUES (4, 6, 1);

query I
SELECT * FROM clickhouse_query('ch', 'SELECT count() FROM (SELECT name FROM system.parts_columns WHERE database = ''w_alter'' AND table = ''dflt'' AND active GROUP BY name HAVING NOT has(groupArray(column), ''c''))');
----
3

statement ok
ALTER TABLE ch.w_alter.dflt ALTER COLUMN c SET DEFAULT 7;

statement ok
ALTER TABLE ch.w_alter.dflt ALTER COLUMN e SET DEFAULT 9;

query III
SELECT id, c, e FROM ch.w_alter.dflt ORDER BY id;
----
1	5	NULL
2	5	NULL
3	5	NULL
4	6	1

statement ok
ALTER TABLE ch.w_alter.dflt ALTER COLUMN c DROP DEFAULT;

query III
SELECT * FROM clickhouse_query('ch', 'SELECT id, c, e FROM w_alter.dflt ORDER BY id');
----
1	5	NULL
2	5	NULL
3	5	NULL
4	6	1

query I
SELECT * FROM clickhouse_query('ch', 'SELECT count() FROM (SELECT name FROM system.parts_columns WHERE database = ''w_alter'' AND table = ''dflt'' AND active GROUP BY name HAVING NOT has(groupArray(column), ''c'') OR NOT has(groupArray(column), ''e''))');
----
0

# a column with a DEFAULT is materialized from it, one without by rewriting it with itself
query I
SELECT * FROM clickhouse_query('ch', 'SELECT command FROM system.mutations WHERE database = ''w_alter'' AND table = ''dflt'' ORDER BY create_time, command');
----
(MATERIALIZE COLUMN c)
(UPDATE e = e WHERE 1)

query III
SELECT * FROM clickhouse_query('ch', 'SELECT name, default_kind, default_expression FROM system.columns WHERE database = ''w_alter'' AND table = ''dflt'' AND name IN (''c'', ''e'') ORDER BY name');
----
c	(empty)	(empty)
e	DEFAULT	9

statement ok
INSERT INTO ch.w_alter.dflt (id) VALUES (5);

query III
SELECT id, c, e FROM ch.w_alter.dflt WHERE id = 5;
----
5	NULL	9

# every part stores both now: nothing more to materialize
statement ok
ALTER TABLE ch.w_alter.dflt ALTER COLUMN e SET DEFAULT 10;

query I
SELECT * FROM clickhouse_query('ch', 'SELECT count() FROM system.mutations WHERE database = ''w_alter'' AND table = ''dflt''');
----
2

# with ch_mutations_sync = 0 the materialization would still be running when the default changes: refused
statement ok
INSERT INTO ch.w_alter.dflt (id) VALUES (6);

statement ok
ALTER TABLE ch.w_alter.dflt ADD COLUMN g INTEGER DEFAULT 5;

statement ok
SET ch_mutations_sync = 0;

statement error
ALTER TABLE ch.w_alter.dflt ALTER COLUMN g SET DEFAULT 7;
----
Cannot change the default of column "g" of ClickHouse table "dflt": 6 part(s) do not store the column yet

query I
SELECT DISTINCT g FROM ch.w_alter.dflt;
----
5

query I
SELECT * FROM clickhouse_query('ch', 'SELECT default_expression FROM system.columns WHERE database = ''w_alter'' AND table = ''dflt'' AND name = ''g''');
----
5

# nothing to materialize: a metadata-only change, fine without waiting
statement ok
ALTER TABLE ch.w_alter.dflt ALTER COLUMN e SET DEFAULT 11;

statement ok
RESET ch_mutations_sync;

query I
SELECT * FROM clickhouse_query('ch', 'SELECT count() FROM system.mutations WHERE database = ''w_alter'' AND table = ''dflt''');
----
2

# ---------------------------------------------------------------------------
# DROP NOT NULL: Nullable(T), inside LowCardinality
# ---------------------------------------------------------------------------
statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN b DROP NOT NULL;

statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN s DROP NOT NULL;

query II
SELECT * FROM clickhouse_query('ch', 'SELECT name, type FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name IN (''b'', ''s'') ORDER BY name');
----
b	Nullable(Int64)
s	LowCardinality(Nullable(String))

query II
SELECT column_name, "null" FROM (DESCRIBE ch.w_alter.t) WHERE column_name IN ('b', 's') ORDER BY column_name;
----
b	YES
s	YES

# the default survives
query I
SELECT * FROM clickhouse_query('ch', 'SELECT default_expression FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''s''');
----
'it\'s'

query II
SELECT b, s FROM ch.w_alter.t ORDER BY id;
----
3000000000	x
-1	y

# already Nullable: nothing to do
statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN a DROP NOT NULL;

query I
SELECT * FROM clickhouse_query('ch', 'SELECT type FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''a''');
----
Nullable(Int32)

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN arr DROP NOT NULL;
----
Column "arr" (Array(Int32)) cannot be Nullable in ClickHouse

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN id DROP NOT NULL;
----
Column "id" is part of the sorting, primary, partition or sampling key of ClickHouse table "t"

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN p DROP NOT NULL;
----
Column "p" is part of the sorting, primary, partition or sampling key of ClickHouse table "t"

# ---------------------------------------------------------------------------
# SET NOT NULL: refused while NULLs are present, and then nothing is sent
# ---------------------------------------------------------------------------
statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN n SET NOT NULL;
----
NOT NULL constraint failed: t.n (2 stored row(s) of the ClickHouse table hold NULL, counting deleted rows not purged yet

query II
SELECT id, n FROM ch.w_alter.t ORDER BY id;
----
1	NULL
2	5

query I
SELECT * FROM clickhouse_query('ch', 'SELECT type FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''n''');
----
Nullable(Int32)

query I
SELECT * FROM clickhouse_query('ch', 'SELECT count() FROM system.mutations WHERE database = ''w_alter'' AND command LIKE ''%MODIFY COLUMN `n`%''');
----
0

statement ok
UPDATE ch.w_alter.t SET n = 0 WHERE n IS NULL;

# row 3, deleted above, is only masked: the mutation would still convert its NULL and fail, leaving the table
# unreadable behind a stuck mutation
statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN n SET NOT NULL;
----
NOT NULL constraint failed: t.n (1 stored row(s)

statement ok
CALL clickhouse_execute('ch', 'ALTER TABLE w_alter.t APPLY DELETED MASK SETTINGS mutations_sync = 2');

statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN n SET NOT NULL;

statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN s SET NOT NULL;

query II
SELECT * FROM clickhouse_query('ch', 'SELECT name, type FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name IN (''n'', ''s'') ORDER BY name');
----
n	Int32
s	LowCardinality(String)

query II
SELECT column_name, "null" FROM (DESCRIBE ch.w_alter.t) WHERE column_name IN ('n', 's') ORDER BY column_name;
----
n	NO
s	NO

query III
SELECT id, n, s FROM ch.w_alter.t ORDER BY id;
----
1	0	x
2	5	y

# already non-Nullable: nothing to do (the key column included)
statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN id SET NOT NULL;

# ---------------------------------------------------------------------------
# TYPE: a closed list of conversions that keep every value, keeping the Nullable-ness; nothing else is sent
# ---------------------------------------------------------------------------
statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN a TYPE BIGINT;

query II
SELECT * FROM clickhouse_query('ch', 'SELECT type, default_kind FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''a''');
----
Nullable(Int64)	(empty)

query II
SELECT column_type, "null" FROM (DESCRIBE ch.w_alter.t) WHERE column_name = 'a';
----
BIGINT	YES

query I
SELECT a FROM ch.w_alter.t ORDER BY id;
----
10
NULL

statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN a TYPE VARCHAR;

query I
SELECT * FROM clickhouse_query('ch', 'SELECT type FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''a''');
----
Nullable(String)

query I
SELECT a FROM ch.w_alter.t WHERE a = '10';
----
10

statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN d TYPE TIMESTAMP;

query I
SELECT * FROM clickhouse_query('ch', 'SELECT type FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''d''');
----
DateTime64(6, 'UTC')

query I
SELECT d FROM ch.w_alter.t ORDER BY id;
----
2024-01-02 00:00:00+00
1900-01-01 00:00:00+00

statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN dec TYPE DECIMAL(12, 4);

query I
SELECT * FROM clickhouse_query('ch', 'SELECT type FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''dec''');
----
Decimal(12, 4)

query I
SELECT dec FROM ch.w_alter.t ORDER BY id;
----
1.2500
-3.5000

# narrowing would wrap 3000000000 (DuckDB refuses the ALTER): refused whatever the values
statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN b TYPE INTEGER;
----
Cannot change the type of column "b" of ClickHouse table "t" from BIGINT to INTEGER: only conversions that keep every value exactly are supported

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN b TYPE UINTEGER;
----
from BIGINT to UINTEGER: only conversions that keep every value exactly are supported

query I
SELECT * FROM clickhouse_query('ch', 'SELECT type FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''b''');
----
Nullable(Int64)

query I
SELECT b FROM ch.w_alter.t ORDER BY id;
----
3000000000
-1

# the same type: nothing to do (LowCardinality kept)
statement ok
ALTER TABLE ch.w_alter.t ALTER COLUMN s TYPE VARCHAR;

query I
SELECT * FROM clickhouse_query('ch', 'SELECT type FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''s''');
----
LowCardinality(String)

# rounding, out-of-range and inexact conversions are refused whatever the values
statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN f TYPE INTEGER;
----
Cannot change the type of column "f" of ClickHouse table "t" from DOUBLE to INTEGER: only conversions that keep every value exactly are supported

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN dec TYPE DECIMAL(10, 1);
----
from DECIMAL(12,4) to DECIMAL(10,1): only conversions that keep every value exactly are supported

# fewer integer digits: ClickHouse would store 12345.67 in a Decimal(4, 2) unchecked
statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN dec TYPE DECIMAL(6, 4);
----
from DECIMAL(12,4) to DECIMAL(6,4): only conversions that keep every value exactly are supported

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN dec TYPE FLOAT;
----
only conversions that keep every value exactly are supported

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN f TYPE VARCHAR;
----
only conversions that keep every value exactly are supported

# DateTime64 columns read as TIMESTAMP WITH TIME ZONE
statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN d TYPE DATE;
----
from TIMESTAMP WITH TIME ZONE to DATE: only conversions that keep every value exactly are supported

# a string column: ClickHouse's parse is not DuckDB's, refused even though every value would convert
statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN txt TYPE INTEGER;
----
Cannot change the type of column "txt" of ClickHouse table "t" from VARCHAR to INTEGER: only conversions that keep every value exactly are supported

query II
SELECT id, txt FROM ch.w_alter.t ORDER BY id;
----
1	12
2	abc

query I
SELECT * FROM clickhouse_query('ch', 'SELECT type FROM system.columns WHERE database = ''w_alter'' AND table = ''t'' AND name = ''txt''');
----
Nullable(String)

query I
SELECT * FROM clickhouse_query('ch', 'SELECT count() FROM system.mutations WHERE database = ''w_alter'' AND table = ''t'' AND command LIKE ''%MODIFY COLUMN%'' AND (command LIKE ''%`b` Nullable(Int32)%'' OR command LIKE ''%`b` Nullable(UInt32)%'' OR command LIKE ''%`f`%'' OR command LIKE ''%`txt`%'' OR command LIKE ''%`dec` Decimal(10%'' OR command LIKE ''%`dec` Decimal(6%'' OR command LIKE ''%`dec` Float32%'' OR command LIKE ''%`d` Date32%'')');
----
0

# every accepted conversion, at the bounds of its source type: the same values as DuckDB's own ALTER
statement ok
CALL clickhouse_execute('ch', 'CREATE TABLE w_alter.ty (id Int32, i8 Nullable(Int8), u8 UInt8, i16 Int16, u16 UInt16, i32 Nullable(Int32), u32 UInt32, i64 Int64, u64 UInt64, u64s UInt64, f32 Float32, i16f Int16, u16f UInt16, i32f Int32, u32f UInt32, i32d Int32, u64d UInt64, dec Decimal(18, 2), i8v Int8, i64v Nullable(Int64), u64v UInt64, i128v Int128, u128v UInt128, dv Nullable(Date32), dt Nullable(Date32), dd Date, e Enum8(''a'' = 5, ''b'' = -3), lc LowCardinality(Nullable(Int32))) ENGINE = MergeTree ORDER BY id SETTINGS allow_suspicious_low_cardinality_types = 1');

statement ok
CALL clickhouse_execute('ch', 'INSERT INTO w_alter.ty VALUES (1, -128, 0, -32768, 0, -2147483648, 0, -9223372036854775808, 0, 0, -3.25, -32768, 0, -2147483648, 0, -2147483648, 0, -9999999999999999.99, -128, -9223372036854775808, 0, -170141183460469231731687303715884105728, 0, ''1900-01-01'', ''1900-01-01'', ''1970-01-01'', ''a'', -2147483648), (2, 127, 255, 32767, 65535, 2147483647, 4294967295, 9223372036854775807, 18446744073709551615, 18446744073709551615, 16777216, 32767, 65535, 2147483647, 4294967295, 2147483647, 18446744073709551615, 9999999999999999.99, 127, 9223372036854775807, 18446744073709551615, 170141183460469231731687303715884105727, 340282366920938463463374607431768211455, ''2299-12-31'', ''2299-12-31'', ''2149-06-06'', ''b'', 7), (3, NULL, 1, -1, 1, NULL, 1, -1, 1, 1, 0.1, -1, 1, -16777217, 1, -1, 1, -0.01, -1, NULL, 1, -1, 1, NULL, NULL, ''2024-02-29'', ''a'', NULL)');

statement ok
CREATE TABLE ty_local AS SELECT * FROM ch.w_alter.ty;

foreach col,type i8,SMALLINT u8,SMALLINT i16,INTEGER u16,UINTEGER i32,BIGINT u32,BIGINT i64,HUGEINT u64,UHUGEINT u64s,HUGEINT f32,DOUBLE i16f,FLOAT u16f,FLOAT i32f,DOUBLE u32f,DOUBLE i8v,VARCHAR i64v,VARCHAR u64v,VARCHAR i128v,VARCHAR u128v,VARCHAR dv,VARCHAR dt,TIMESTAMP dd,VARCHAR e,VARCHAR lc,VARCHAR

statement ok
ALTER TABLE ch.w_alter.ty ALTER COLUMN {col} TYPE {type};

statement ok
ALTER TABLE ty_local ALTER COLUMN {col} TYPE {type};

endloop

foreach tbl ch.w_alter.ty ty_local

statement ok
ALTER TABLE {tbl} ALTER COLUMN i32d TYPE DECIMAL(12, 2);

statement ok
ALTER TABLE {tbl} ALTER COLUMN u64d TYPE DECIMAL(20, 0);

statement ok
ALTER TABLE {tbl} ALTER COLUMN dec TYPE DECIMAL(38, 4);

endloop

# DateTime64 reads as TIMESTAMP WITH TIME ZONE: compared as the local TIMESTAMP in UTC
query I
SELECT count(*) FROM (SELECT * REPLACE (dt::TIMESTAMP AS dt) FROM ch.w_alter.ty EXCEPT SELECT * FROM ty_local);
----
0

query I
SELECT count(*) FROM (SELECT * FROM ty_local EXCEPT SELECT * REPLACE (dt::TIMESTAMP AS dt) FROM ch.w_alter.ty);
----
0

query IIIIIIII
SELECT id, i64, u64, f32, dec, i128v, dt, e FROM ch.w_alter.ty ORDER BY id;
----
1	-9223372036854775808	0	-3.25	-9999999999999999.9900	-170141183460469231731687303715884105728	1900-01-01 00:00:00+00	a
2	9223372036854775807	18446744073709551615	16777216.0	9999999999999999.9900	170141183460469231731687303715884105727	2299-12-31 00:00:00+00	b
3	-1	1	0.10000000149011612	-0.0100	-1	NULL	a

query IIIIIIIII
SELECT id, i8, i32, i64v, dv, dd, lc, i32f, u64d FROM ch.w_alter.ty ORDER BY id;
----
1	-128	-2147483648	-9223372036854775808	1900-01-01	1970-01-01	-2147483648	-2147483648.0	0
2	127	2147483647	9223372036854775807	2299-12-31	2149-06-06	7	2147483647.0	18446744073709551615
3	NULL	NULL	NULL	NULL	2024-02-29	NULL	-16777217.0	1

# Nullable and LowCardinality are kept
query II
SELECT * FROM clickhouse_query('ch', 'SELECT name, type FROM system.columns WHERE database = ''w_alter'' AND table = ''ty'' AND name != ''id'' ORDER BY position');
----
i8	Nullable(Int16)
u8	Int16
i16	Int32
u16	UInt32
i32	Nullable(Int64)
u32	Int64
i64	Int128
u64	UInt128
u64s	Int128
f32	Float64
i16f	Float32
u16f	Float32
i32f	Float64
u32f	Float64
i32d	Decimal(12, 2)
u64d	Decimal(20, 0)
dec	Decimal(38, 4)
i8v	String
i64v	Nullable(String)
u64v	String
i128v	String
u128v	String
dv	Nullable(String)
dt	Nullable(DateTime64(6, 'UTC'))
dd	String
e	String
lc	LowCardinality(Nullable(String))

query II
SELECT * FROM clickhouse_query('ch', 'SELECT id, isNull(lc) FROM w_alter.ty ORDER BY id');
----
1	0
2	0
3	1

# one step short of the whole source range, or a time-zone-dependent conversion: refused
statement ok
CALL clickhouse_execute('ch', 'CREATE TABLE w_alter.ty2 (id Int32, i32 Int32, u32 UInt32, i64 Int64, u64 UInt64, d Date32, s LowCardinality(Nullable(String)), bl Bool, i8 Int8) ENGINE = MergeTree ORDER BY id');

statement ok
CALL clickhouse_execute('ch', 'INSERT INTO w_alter.ty2 VALUES (1, 1, 1, 1, 1, ''2024-01-01'', ''1'', true, 1), (2, 2, 2, 2, 2, ''2024-01-02'', NULL, false, 2)');

foreach col,type i32,SMALLINT u32,INTEGER i64,UBIGINT u64,BIGINT i32,FLOAT i64,DOUBLE i32,DECIMAL(9) u64,DECIMAL(19) d,TIMESTAMP_S d,TIMESTAMP_MS d,TIMESTAMP_NS d,TIMESTAMPTZ s,INTEGER bl,INTEGER bl,VARCHAR i8,BOOLEAN i32,DATE

statement error
ALTER TABLE ch.w_alter.ty2 ALTER COLUMN {col} TYPE {type};
----
only conversions that keep every value exactly are supported

endloop

statement error
ALTER TABLE ch.w_alter.ty2 ALTER COLUMN i32 TYPE DECIMAL(12, 3);
----
from INTEGER to DECIMAL(12,3): only conversions that keep every value exactly are supported

query II
SELECT * FROM clickhouse_query('ch', 'SELECT name, type FROM system.columns WHERE database = ''w_alter'' AND table = ''ty2'' AND name != ''id'' ORDER BY position');
----
i32	Int32
u32	UInt32
i64	Int64
u64	UInt64
d	Date32
s	LowCardinality(Nullable(String))
bl	Bool
i8	Int8

query I
SELECT * FROM clickhouse_query('ch', 'SELECT count() FROM system.mutations WHERE database = ''w_alter'' AND table = ''ty2''');
----
0

query II
SELECT id, s FROM ch.w_alter.ty2 ORDER BY id;
----
1	1
2	NULL

# the same type is still a no-op on a LowCardinality(Nullable(String)) column holding NULLs
statement ok
ALTER TABLE ch.w_alter.ty2 ALTER COLUMN s TYPE VARCHAR;

query I
SELECT * FROM clickhouse_query('ch', 'SELECT type FROM system.columns WHERE database = ''w_alter'' AND table = ''ty2'' AND name = ''s''');
----
LowCardinality(Nullable(String))

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN n TYPE BIGINT USING n + 1;
----
ALTER COLUMN … TYPE … USING is not supported for ClickHouse tables

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN id TYPE BIGINT;
----
Column "id" is part of the sorting, primary, partition or sampling key of ClickHouse table "t"

statement error
ALTER TABLE ch.w_alter.t ALTER COLUMN arr TYPE BIGINT[];
----
