NOT NULL constraint failed: mem.v

statement ok
ALTER TABLE ch.w_alter.mem ALTER COLUMN v TYPE BIGINT;

statement ok
ALTER TABLE ch.w_alter.mem ALTER COLUMN id DROP NOT NULL;

statement ok
ALTER TABLE ch.w_alter.mem ALTER COLUMN v SET DEFAULT 9;

query III
SELECT * FROM clickhouse_query('ch', 'SELECT name, type, default_expression FROM system.columns WHERE database = ''w_alter'' AND table = ''mem'' ORDER BY position');
