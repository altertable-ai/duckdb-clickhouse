1	NULL
2	3

# Memory stores a column for the existing rows when it is added: a new default does not reach them
statement ok
ALTER TABLE ch.w_alter.mem ADD COLUMN e INTEGER;

statement ok
ALTER TABLE ch.w_alter.mem ALTER COLUMN e SET DEFAULT 9;

statement ok
INSERT INTO ch.w_alter.mem (id) VALUES (3);

query III
SELECT * FROM ch.w_alter.mem ORDER BY id;
----
1	NULL	NULL
2	3	NULL
3	9	9

statement ok
ALTER TABLE ch.w_alter.mem ALTER COLUMN e DROP DEFAULT;

query II
SELECT * FROM clickhouse_query('ch', 'SELECT id, e FROM w_alter.mem ORDER BY id');
----
1	NULL
2	NULL
3	9

